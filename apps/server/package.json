{
  "name": "@skrible/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 src/validation.test.ts src/profiles.test.ts src/matchmaking.test.ts src/words.test.ts src/features.test.ts src/game.test.ts src/phase4.test.ts src/server.test.ts src/server.phase4.test.ts src/stability.test.ts src/phase5.integration.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 src/phase5.integration.test.ts",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.1",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
