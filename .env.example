# Copy to .env for local development. NEVER commit real credentials.
NODE_ENV=development
PORT=3001

# PostgreSQL (see infra/docker-compose.yml for the local ports)
DATABASE_URL=postgres://skrible:skrible_dev_password@localhost:55432/skrible

# Redis
REDIS_URL=redis://localhost:56379

# Stable identity for this server process. Room snapshots and matchmaking
# queues are instance-affine; use a distinct value for every instance.
INSTANCE_ID=server-1

# Comma-separated browser origins allowed to call the HTTP API / Socket.IO.
# Leave empty in development to reflect any origin; production requires an allowlist.
CORS_ORIGINS=

# Admin bearer token for moderation endpoints. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# How long a guest session token stays valid (days)
AUTH_TOKEN_TTL_DAYS=30

# Matchmaking
MM_MIN=2
MM_MAX=8
MM_WAIT_MS=45000

# Logging
LOG_LEVEL=info

# Set to 1 when running behind a TLS-terminating proxy (trusts X-Forwarded-*).
TRUST_PROXY=1

# How long graceful shutdown may take before the process exits.
SHUTDOWN_TIMEOUT_MS=15000

# How long a disconnected player's seat, score and turn are held for a
# reconnect before the seat is released. 1000-120000 ms.
RECONNECT_GRACE_MS=45000
